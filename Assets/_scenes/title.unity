      m_Calls: []
  m_text: "<color=#A2BCCB>Creative Director</color>\nWren Brier\n\n\n<color=#A2BCCB>Technical Director</color>\nTim Dawson\n\n\n<color=#A2BCCB>Audio Director</color>\nJeff van Dyck\n\n\n<color=#A2BCCB>Pixel Art</color>\nAngus Doolan\nWren Brier\nMichelle Whitehead\nJoseph-Paul Silipo\n\n\n<color=#A2BCCB>Music & Sound Design</color>\nJeff van Dyck\n\n\n<color=#A2BCCB>Foley Production</color>\nAngela van Dyck\n\n\n<color=#A2BCCB>Additional Foley</color>\nElla van Dyck\n\n\n<color=#A2BCCB>Game Design</color>\nWren Brier\nTim Dawson\n\n\n<color=#A2BCCB>Narrative Assistance</color>\nAnnie VanderMeer\n\n\n<color=#A2BCCB>Additional Coding</color>\nDaemon Walters\n\n\n<color=#A2BCCB>Hero Image and Stickers</color>\nStacey Richmond\n\n\n<color=#A2BCCB>Title Screen Art</color>\nAngus Doolan\n\n\n<color=#A2BCCB>Animation Pre-vis</color>\nTim Dawson\n\n\n<color=#A2BCCB>Development & Business Support</color>\nSanatana Mishra\n\n\n<color=#A2BCCB>Community Strategy</color>\nVictoria Tran\n\n\n<color=#A2BCCB>Website Design</color>\nCassie Selin\n\n\n<color=#A2BCCB>Legal Assistance</color>\nCam Rogers Legal\n"
  m_isRightToLeft: 0
