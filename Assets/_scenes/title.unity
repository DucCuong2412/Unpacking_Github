  m_text: "<color=#A2BCCB>Senior Director,<br>Global Publishing Operations\r</color>\r\nMark Nash\r\r\n\r\n<color=#A2BCCB>Director, Portfolio\r</color>\r\nJohn Polson\r\r\n\r\n<color=#A2BCCB>Director, Production\r</color>\r\nRodrigo Aguilar\r\r\n\r\n<color=#A2BCCB>Producer\r</color>\r\nDan Adams\r\r\n\r\n<color=#A2BCCB>Senior Release Manager\r</color>\r\nEvan Koepf\r\r\n\r\n<color=#A2BCCB>Director of Community</color>\r\nAndrew Kauz\n"
  m_isRightToLeft: 0
