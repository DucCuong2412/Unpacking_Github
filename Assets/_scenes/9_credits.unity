      m_Calls: []
  m_text: "<color=#A2BCCB>Executive Vice-President & General Manager\r</color>\r\nAlan Patmore\r\r\n\r\n<color=#A2BCCB>Senior Director, Global Publishing Operations\r</color>\r\nMark Nash\r\r\n\r\n<color=#A2BCCB>VP, Marketing\r</color>\r\nJeremie Vella\r\r\n\r\n<color=#A2BCCB>Director, Portfolio\r</color>\r\nJohn Polson\r\r\n\r\n<color=#A2BCCB>Director, Business Development\r</color>\r\nMai Kawaguchi\r\r\n\r\n<color=#A2BCCB>Director, Production\r</color>\r\nRodrigo Aguilar\r\r\n\r\n<color=#A2BCCB>Senior Producer\r</color>\r\nAndrew D. Nguyen\r\r\n\r\n<color=#A2BCCB>Producer\r</color>\r\nDan Adams\r\r\n\r\n<color=#A2BCCB>Producer\r</color>\r\nRoss Marabella\r\r\n\r\n<color=#A2BCCB>Senior Release Manager\r</color>\r\nEvan Koepf\r\r\n\r\r\n<color=#A2BCCB>Brand Manager</color>\r\nConnor Bridgeman\r\n\n<color=#A2BCCB>Director of Community</color>\r\nAndrew Kauz\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: cff88804b88a3974089cc51d95f2d838, type: 2}
