  m_text: "<color=#A2BCCB>VP, Business Operations\r</color>\r\nEric Samuel\r\r\n\r\n<color=#A2BCCB>VP, Strategy\r</color>\r\nNate Muller\r\r\n\r\n<color=#A2BCCB>VP, Business Development\r</color>\r\nPaul Herron\r\r\n\r\n<color=#A2BCCB>VP, Social Impact and Internal Communications\r</color>\r\nKamini Tiwari\r\r\n\r\n<color=#A2BCCB>Director, Customer Support\r</color>\r\nAllie Kafka\r\r\n\r\n<color=#A2BCCB>Director of Growth\r</color>\r\nDwight Zhou\r\r\n\r\n<color=#A2BCCB>Marketing Growth Manager, Email\r</color>\r\nJess Zepeda \r\r\n\r\n<color=#A2BCCB>Marketing Growth Manager, Paid\r</color>\r\nGina Hwang\r\r\n\r\n<color=#A2BCCB>Associate Marketing Manager\r</color>\r\nPJ Martin\r\r\n\r\n<color=#A2BCCB>Sr. Human Resources Business Partner\r</color>\r\nSean Mitchel\r\r\n\r\n<color=#A2BCCB>President, Ziff Davis\r</color>\r\nSteve Horowitz\r\r\n\r\n<color=#A2BCCB>Senior Vice President, Finance & Operations, Ziff Davis\r</color>\r\nAbby S. Bilanin\r\r\n\r\n<color=#A2BCCB>Director, Finance & Operations, Ziff Davis\r</color>\r\nDaniel Cleary \r\r\n\r\n<color=#A2BCCB>Manager, Finance, Ziff Davis\r</color>\r\nBrandon Conte\r\r\n\r\n<color=#A2BCCB>Assistant General Counsel, Digital Media, Ziff Davis\r</color>\r\nNatalia Cianfaglione\r\r\n\r\n<color=#A2BCCB>Corporate Counsel, Ziff Davis</color>\r\nBrittany Curtis\r\n"
